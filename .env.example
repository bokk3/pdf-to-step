# Copy to .env (git-ignored). Keys map 1:1 to backend/app/config.py (case-insensitive).
# The API key stays on the server: it is never sent to the browser.

# --- DeepSeek (OpenAI SDK, base_url https://api.deepseek.com) --------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-chat / deepseek-reasoner are retired: always set model IDs here.
DEEPSEEK_VISION_MODEL=deepseek-flash
DEEPSEEK_CODE_MODEL=deepseek-v4-pro
# Thinking mode: enabled | disabled | default (model decides)
#   extraction + spec correction (§2 stage 2): enabled per spec; ~2-3 min per call on deepseek-flash,
#   "disabled" is ~25x faster and was equally accurate on the sample drawing.
DEEPSEEK_THINKING=enabled
DEEPSEEK_CRITIC_THINKING=enabled
# Reasoning tokens count against this budget; too small -> empty completions (auto-halved if rejected)
DEEPSEEK_MAX_TOKENS=65536
DEEPSEEK_TIMEOUT_S=600
# Upload drawing images once per job (Files API, purpose user_data) and reuse them by file_id
DEEPSEEK_USE_FILES_API=true
# Force the offline mock client even if a key is set
DEEPSEEK_MOCK=false

# --- Server: loopback only, remote access via `tailscale serve` -----------------
# Fixed, dedicated ports (chosen to avoid common dev defaults such as 8000/3000/5173 and the Windows
# dynamic range 49152+). Check yours with: Get-NetTCPConnection -State Listen  /  ss -ltn
HOST=127.0.0.1
PORT=8620
# Vite dev server (scripts/dev.*), proxies /api to PORT
VITE_DEV_PORT=5620
# Tailnet HTTPS port published by scripts/service.ps1 + start_tailscale.* (use 443 if nothing else is served there)
TAILSCALE_HTTPS_PORT=8445

# --- Storage ------------------------------------------------------------------------
DATA_DIR=./data

# --- Pipeline -------------------------------------------------------------------------
MAX_HEAL_RETRIES=3
SANDBOX_TIMEOUT_S=15
CRITIC_ENABLED=true
RENDER_DPI=300
LLM_IMAGE_MAX_PIXELS=1690000
CAD_WORKERS=2
# AP214 (widest CAM compatibility) or AP242
STEP_SCHEMA=AP214
# §8.6 colour threaded bores blue and tight-tolerance (H7...) bores red in the STEP (XCAF)
STEP_FACE_COLORS=true
# EN ISO detail drawing (drawing.pdf/.svg/.dxf) for every built revision (DRAWING_SPEC.md)
DRAWING_ENABLED=true
# Title block 'owner' cell (company name); empty = blank
DRAWING_OWNER=
# DRAWING_FONT=C:/path/to/font.ttf  # lettering font; default: Segoe UI Symbol when installed (has the ISO
#   symbols ⌴ ⌵ ↧), otherwise DejaVu Sans (callouts then say CBORE / CSK)
# Hand sketches: add the DeepSeek Files API text layer (off | text_recognition | rich_layout_recognition)
SKETCH_OCR=off
SKETCH_OCR_WAIT_S=3

# --- DFM thresholds (§8) ----------------------------------------------------------------
DFM_BBOX_TOLERANCE_MM=0.01
DFM_MIN_CORNER_RADIUS_MM=1.5
DFM_MAX_HOLE_DEPTH_RATIO=5
DFM_MAX_POCKET_DEPTH_PER_RADIUS=4
DFM_MIN_WALL_MM=1.5
